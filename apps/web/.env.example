# Copy to apps/web/.env.local
DATABASE_URL=./data/leaddesk.db
# JWT_SECRET must be >= 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-string-0123456789
NODE_ENV=development
REDIS_URL=redis://localhost:6379
JOBS_ENABLED=true
AT_RISK_DAYS=3
COLD_AFTER_DAYS=7
COLD_AFTER_UNANSWERED=3
MISSED_AFTER_HOURS=24
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_RATE_LIMIT_PER_HOUR=30
